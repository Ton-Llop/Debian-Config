# Optional environment file for the GSX backup systemd service.
#
# Copy to: /etc/gsx-admin/backup.env
# Permissions: root:root 0600 (or 0640) recommended.
#
# If this file does NOT exist, backups still run (plaintext tar + sha256)
# because opt/04-backup-secrets.sh uses ENCRYPT_MODE=auto by default.
#
# To force encryption for timers, uncomment and set PASSPHRASE and ENCRYPT_MODE=gpg.

# ENCRYPT_MODE=auto
# ENCRYPT_MODE=gpg
# ENCRYPT_MODE=none

# PASSPHRASE=change-me
