# 3-2-1 backup runtime configuration example
# Copy target created by opt/17-backup-setup.sh:
#   /etc/gsx-admin/backup-tot.env

# Main backup disk mount point
BACKUP_ROOT=/srv/week5-data

# Optional explicit paths; if omitted, script 17 appends defaults
SNAPSHOT_ROOT=/srv/week5-data/gsx-backups/snapshots
RESTORE_ROOT=/srv/week5-data/gsx-backups/restore-tests

# Optional second/offsite copy location
# OFFSITE_DIR=/srv/week5-offsite/latest

# Retention policy
KEEP_DAILY_DAYS=7
KEEP_WEEKLY_WEEKS=4
KEEP_MONTHLY_MONTHS=3

# Require backup root to be on a filesystem different from /
REQUIRE_SEPARATE_FILESYSTEM=1

# Space-separated list of sources to back up
BACKUP_SOURCES="/etc /home/gsx /home/greendevcorp /home/dev1 /home/dev2 /home/dev3 /home/dev4 /srv/gsx-admin /var/www"